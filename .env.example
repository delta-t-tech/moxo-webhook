# Stripe secret key (from https://dashboard.stripe.com/apikeys)
# Use sk_test_... for testing, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...

# Shared secret to authenticate requests from Moxo
# Set this in both Railway and in your Moxo webhook configuration
WEBHOOK_SECRET=change-me-to-something-random

# Fallback URLs if not provided in the request body
DEFAULT_SUCCESS_URL=https://yoursite.com/success
DEFAULT_CANCEL_URL=https://yoursite.com/cancel

# Port (Railway sets this automatically — no need to change)
PORT=3000
